{"files":[{"id":"0a0e3539-b0c2-41a6-8952-e4554a89f47e","name":"appsscript","type":"json","source":"{\n  \"timeZone\": \"Asia/Jakarta\",\n  \"dependencies\": {},\n  \"exceptionLogging\": \"STACKDRIVER\",\n  \"runtimeVersion\": \"V8\",\n  \"webapp\": {\n    \"executeAs\": \"USER_DEPLOYING\",\n    \"access\": \"ANYONE_ANONYMOUS\"\n  }\n}"},{"id":"0551ab93-c6cc-463e-a4f3-4ffc8d67bc1f","name":"Kode","type":"server_js","source":"function doGet() {\n  return HtmlService.createHtmlOutputFromFile(\u0027index\u0027)\n      .setTitle(\u0027TIAN PROJECT\u0027)\n      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)\n      .addMetaTag(\u0027viewport\u0027, \u0027width\u003ddevice-width, initial-scale\u003d1\u0027);\n}\n\n// FUNGSI KHUSUS UNTUK MENGIRIM EMAIL OTP ASLI SECARA NYATA\nfunction sendOtpEmail(targetEmail, otpCode) {\n  try {\n    MailApp.sendEmail({\n      to: targetEmail,\n      subject: \"🔑 KODE OTP PENDAFTARAN - TIAN PROJECT\",\n      htmlBody: `\n        \u003cdiv style\u003d\"font-family: Arial, sans-serif; background-color: #0b0f12; color: #ffffff; padding: 30px; border-radius: 8px; border: 2px solid #39ff14; max-width: 450px; margin: 0 auto;\"\u003e\n          \u003ch2 style\u003d\"color: #39ff14; text-align: center; font-weight: 900; letter-spacing: 2px;\"\u003eTIAN PROJECT\u003c/h2\u003e\n          \u003cp style\u003d\"color: #a0aec0; font-size: 15px; text-align: center;\"\u003eHalo, Anda sedang melakukan pendaftaran akun game di Tian Project.\u003c/p\u003e\n          \u003cdiv style\u003d\"background-color: #141a1f; border: 1px dashed #39ff14; padding: 15px; text-align: center; border-radius: 6px; margin: 20px 0;\"\u003e\n            \u003cspan style\u003d\"font-size: 32px; font-weight: bold; color: #39ff14; letter-spacing: 10px;\"\u003e${otpCode}\u003c/span\u003e\n          \u003c/div\u003e\n          \u003cp style\u003d\"color: #ff3333; font-size: 12px; text-align: center; font-weight: bold;\"\u003eBatas waktu tunggu kode OTP ini adalah 7 menit!\u003c/p\u003e\n          \u003chr style\u003d\"border-color: #232d35; margin-top: 25px;\"\u003e\n          \u003cp style\u003d\"color: #a0aec0; font-size: 11px; text-align: center;\"\u003e\u0026copy; 2026 TIAN PROJECT. All Rights Reserved.\u003c/p\u003e\n        \u003c/div\u003e\n      `\n    });\n    return \"SUKSES\";\n  } catch (error) {\n    return \"GAGAL: \" + error.toString();\n  }\n}\n\n"},{"id":"fe413b5d-0dfd-4e96-a2b3-733c12beb8c2","name":"index","type":"html","source":"\u003c!DOCTYPE html\u003e\n\u003chtml lang\u003d\"id\"\u003e\n\u003chead\u003e\n    \u003cmeta charset\u003d\"UTF-8\"\u003e\n    \u003cmeta name\u003d\"viewport\" content\u003d\"width\u003ddevice-width, initial-scale\u003d1.0\"\u003e\n    \u003ctitle\u003eTIAN PROJECT\u003c/title\u003e\n    \u003cstyle\u003e\n        /* --- 1. PENGATURAN DASAR \u0026 TEMA HIJAU NYALA --- */\n        * { box-sizing: border-box; margin: 0; padding: 0; font-family: \u0027Segoe UI\u0027, Roboto, sans-serif; }\n        :root { --bg-dark: #0b0f12; --bg-card: #141a1f; --neon-green: #39ff14; --text-light: #ffffff; --text-gray: #a0aec0; }\n        body { background-color: var(--bg-dark); color: var(--text-light); scroll-behavior: smooth; overflow-x: hidden; }\n\n        /* --- 2. ANIMASI LOADING PREMIUM (WETT YAA) --- */\n        #loader-wrapper { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: #050709; z-index: 9999; display: flex; flex-direction: column; justify-content: center; align-items: center; transition: opacity 0.4s ease, visibility 0.4s ease; }\n        .premium-spinner { width: 65px; height: 65px; border: 4px solid rgba(57, 255, 20, 0.1); border-top: 4px solid var(--neon-green); border-radius: 50%; animation: spin 0.8s linear infinite; box-shadow: 0 0 20px rgba(57, 255, 20, 0.4); margin-bottom: 25px; }\n        .loading-text { color: var(--neon-green); font-size: 1.4rem; font-weight: 900; letter-spacing: 6px; text-transform: uppercase; text-shadow: 0 0 15px rgba(57, 255, 20, 0.8); animation: pulse-glow 1.2s ease-in-out infinite; }\n        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }\n        @keyframes pulse-glow { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; text-shadow: 0 0 25px var(--neon-green); } }\n        .loader-hidden { opacity: 0; visibility: hidden; pointer-events: none; }\n\n        /* --- 3. HEADER NAVIGASI --- */\n        header { background: #0f1418; border-bottom: 2px solid var(--neon-green); padding: 20px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1000; box-shadow: 0 0 15px rgba(57, 255, 20, 0.2); }\n        .logo { font-size: 1.8rem; font-weight: 900; color: var(--neon-green); text-shadow: 0 0 10px rgba(57, 255, 20, 0.6); letter-spacing: 2px; }\n        nav a { color: var(--text-light); text-decoration: none; margin-left: 15px; font-weight: 600; padding: 8px 16px; border-radius: 4px; }\n        nav a:hover { color: var(--bg-dark); background-color: var(--neon-green); box-shadow: 0 0 10px var(--neon-green); }\n        .container { max-width: 1200px; margin: 0 auto; padding: 60px 20px; }\n        .section-title { font-size: 2.2rem; margin-bottom: 35px; color: var(--neon-green); text-transform: uppercase; border-left: 5px solid var(--neon-green); padding-left: 15px; }\n\n        /* --- 4. LAYOUT POP-UP FORM PENDAFTARAN (OVERLAY) --- */\n        .overlay-auth { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(5, 7, 9, 0.96); z-index: 5000; display: flex; justify-content: center; align-items: center; display: none; }\n        .register-card { background: var(--bg-card); border: 2px solid var(--neon-green); border-radius: 12px; padding: 30px; width: 100%; max-width: 400px; box-shadow: 0 0 30px rgba(57, 255, 20, 0.3); }\n        .register-card h3 { text-align: center; color: var(--neon-green); font-size: 1.8rem; margin-bottom: 20px; letter-spacing: 1px; }\n        .form-group { margin-bottom: 15px; }\n        .form-group label { display: block; font-size: 0.85rem; color: var(--text-gray); margin-bottom: 5px; }\n        .form-group input { width: 100%; background: #0b0f12; border: 1px solid #232d35; color: white; padding: 12px; border-radius: 6px; font-size: 1rem; }\n        .form-group input:focus { border-color: var(--neon-green); outline: none; }\n        .btn-submit-auth { width: 100%; background: var(--neon-green); color: var(--bg-dark); border: none; padding: 14px; border-radius: 6px; font-weight: 900; font-size: 1.1rem; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; margin-top: 10px; transition: 0.3s; }\n        .btn-submit-auth:hover { box-shadow: 0 0 15px var(--neon-green); }\n        .timer-text { text-align: center; color: #ff3333; font-weight: bold; margin-top: 12px; font-size: 1.1rem; letter-spacing: 1px; }\n\n        /* --- 5. TIAN PROMUY LAYOUT \u0026 GAME --- */\n        .promuy-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }\n        @media (max-width: 768px) { .promuy-layout { grid-template-columns: 1fr; } }\n        .box-category { background: var(--bg-card); border: 1px solid #232d35; border-radius: 12px; padding: 30px; }\n        .box-category h3 { font-size: 1.5rem; margin-bottom: 20px; border-bottom: 1px solid #232d35; padding-bottom: 10px; }\n        .tool-list li { padding: 12px; background: #1c242b; margin-bottom: 10px; border-radius: 6px; list-style: none; border-left: 3px solid var(--neon-green); }\n        .game-area { background: #1c242b; border: 2px dashed var(--neon-green); border-radius: 8px; padding: 20px; margin-top: 15px; text-align: center; }\n        .money-dashboard { background: #0b0f12; padding: 8px 15px; border-radius: 20px; display: inline-block; font-weight: bold; color: var(--neon-green); border: 1px solid var(--neon-green); margin-bottom: 15px; }\n        .animal-illusion { font-size: 4rem; background: #0b0f12; padding: 20px; border-radius: 8px; margin: 15px 0; display: inline-block; letter-spacing: -15px; border: 1px solid #232d35; min-width: 150px; }\n        .quiz-options { display: flex; flex-direction: column; gap: 10px; margin-top: 15px; }\n        .opt-btn { background: #141a1f; border: 1px solid #3498db; color: #fff; padding: 10px; border-radius: 6px; cursor: pointer; font-weight: 600; }\n        .opt-btn:hover { background: #3498db; box-shadow: 0 0 10px rgba(52, 152, 219, 0.5); }\n        .game-feedback { margin-top: 15px; font-weight: bold; font-size: 1.1rem; }\n\n        /* --- 6. ECOMERS \u0026 MEMBERSHIP --- */\n        .ecomers-grid, .member-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; }\n        .product-card, .member-card { background: var(--bg-card); border-radius: 12px; border: 1px solid #232d35; padding: 25px; transition: 0.3s; }\n        .product-card:hover, .member-card.active { border-color: var(--neon-green); transform: translateY(-5px); }\n        .product-img-holder { background: #232d35; height: 180px; display: flex; align-items: center; justify-content: center; margin-bottom: 15px; border-radius: 6px; }\n        .product-price { color: var(--neon-green); font-weight: bold; font-size: 1.3rem; margin: 10px 0; display: block; }\n        .time-badge { background: var(--neon-green); color: var(--bg-dark); padding: 5px 15px; border-radius: 20px; font-size: 0.8rem; font-weight: bold; display: inline-block; margin-bottom: 15px; }\n        .price-tag { font-size: 2rem; font-weight: 800; margin: 15px 0; }\n        .btn-buy { background: transparent; border: 2px solid var(--neon-green); color: var(--neon-green); padding: 10px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; }\n        .btn-buy:hover { background: var(--neon-green); color: var(--bg-dark); box-shadow: 0 0 10px var(--neon-green); }\n        footer { background: #0f1418; text-align: center; padding: 30px; margin-top: 80px; border-top: 1px solid #232d35; color: var(--text-gray); }\n    \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n    \u003c!-- ⏳ ANIMASI LOADING PREMIUM --\u003e\n    \u003cdiv id\u003d\"loader-wrapper\"\u003e\u003cdiv class\u003d\"premium-spinner\"\u003e\u003c/div\u003e\u003cdiv class\u003d\"loading-text\"\u003eWETT YAA\u003c/div\u003e\u003c/div\u003e\n\n    \u003c!-- 🔒 JENDELA POP-UP PENDAFTARAN UTAMA --\u003e\n    \u003cdiv class\u003d\"overlay-auth\" id\u003d\"auth-modal\"\u003e\n        \u003c!-- LANGKAH 1: ISI DATA DIRI --\u003e\n        \u003cdiv class\u003d\"register-card\" id\u003d\"reg-step-1\"\u003e\n            \u003ch3\u003eDAFTAR DULU YAW\u003c/h3\u003e\n            \n            \u003cdiv class\u003d\"form-group\" style\u003d\"margin-top: 15px;\"\u003e\n                \u003clabel\u003eUsername:\u003c/label\u003e\n                \u003cinput type\u003d\"text\" id\u003d\"reg-username\" placeholder\u003d\"Buat nama pengguna Anda\"\u003e\n            \u003c/div\u003e\n            \n            \u003cdiv class\u003d\"form-group\"\u003e\n                \u003clabel\u003eGmail Asli:\u003c/label\u003e\n                \u003cinput type\u003d\"email\" id\u003d\"reg-email\" placeholder\u003d\"Masukkan gmail aktif Anda\"\u003e\n            \u003c/div\u003e\n            \n            \u003cdiv class\u003d\"form-group\"\u003e\n                \u003clabel\u003eKata Sandi:\u003c/label\u003e\n                \u003cinput type\u003d\"password\" id\u003d\"reg-pass\" placeholder\u003d\"Buat kata sandi baru\"\u003e\n            \u003c/div\u003e\n            \n            \u003cdiv class\u003d\"form-group\"\u003e\n                \u003clabel\u003eMengulang Kata Sandi:\u003c/label\u003e\n                \u003cinput type\u003d\"password\" id\u003d\"reg-pass-confirm\" placeholder\u003d\"Ketik ulang kata sandi Anda\"\u003e\n            \u003c/div\u003e\n            \n            \u003cbutton class\u003d\"btn-submit-auth\" onclick\u003d\"handleRegisterStep1()\"\u003eDAFTAR SEKARANG YAW\u003c/button\u003e\n        \u003c/div\u003e\n\n        \u003c!-- LANGKAH 2: VERIFIKASI KODE OTP 3 DIGIT --\u003e\n        \u003cdiv class\u003d\"register-card\" id\u003d\"reg-step-2\" style\u003d\"display: none;\"\u003e\n            \u003ch3\u003eVERIFIKASI OTP\u003c/h3\u003e\n            \u003cp style\u003d\"font-size: 0.85rem; color: var(--text-gray); text-align: center; margin-bottom: 15px;\" id\u003d\"otp-info-text\"\u003eKode OTP 3-digit telah dikirim ke email Anda.\u003c/p\u003e\n            \n            \u003cdiv class\u003d\"form-group\"\u003e\n                \u003clabel\u003eKolom Kode OTP 3 Digit:\u003c/label\u003e\n                \u003cinput type\u003d\"number\" id\u003d\"otp-input\" placeholder\u003d\"Masukkan 3 digit angka\" min\u003d\"100\" max\u003d\"999\"\u003e\n            \u003c/div\u003e\n            \n            \u003c!-- TIMER HITUNG MUNDUR 7 MENIT --\u003e\n            \u003cdiv class\u003d\"timer-text\" id\u003d\"otp-timer\"\u003e07:00\u003c/div\u003e\n            \n            \u003cbutton class\u003d\"btn-submit-auth\" style\u003d\"background: #3498db; color: #fff;\" onclick\u003d\"handleVerifyOTP()\"\u003eKIRIM YAWW\u003c/button\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- WEB ISI UTAMA --\u003e\n    \u003cheader\u003e\n        \u003cdiv class\u003d\"logo\"\u003eTIAN PROJECT\u003c/div\u003e\n        \u003cnav\u003e\n            \u003ca href\u003d\"#tian-promuy\"\u003eTian Promuy\u003c/a\u003e\n            \u003ca href\u003d\"#ecomers\"\u003eEcomers\u003c/a\u003e\n            \u003ca href\u003d\"#membership\"\u003eMembership\u003c/a\u003e\n        \u003c/nav\u003e\n    \u003c/header\u003e\n\n    \u003csection class\u003d\"container\" id\u003d\"tian-promuy\"\u003e\n"}]}